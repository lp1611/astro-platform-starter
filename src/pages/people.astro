---

<Layout title="People" description="Students, mentees, and collaborators of Lekha Patel.">
    <h1 class="mb-4">People</h1>
    <p class="text-text-muted mb-10">
        Current and former students, mentees, and research collaborators.
    </p>

    <!-- Current Students & Mentees -->
    <section class="mb-12">
        <h2 class="section-heading">Current Students &amp; Mentees</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {currentStudents.map((person) => (
                <div class="card">
                    <h3 class="text-lg mb-1">{person.name}</h3>
                    <p class="text-sm font-medium text-accent mb-1">{person.role}</p>
                    <p class="text-sm text-text-muted mb-2">{person.institution}</p>
                    <p class="text-sm text-text leading-relaxed">{person.topic}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- Past Students & Mentees -->
    <section class="mb-12">
        <h2 class="section-heading">Past Students &amp; Mentees</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {pastStudents.map((person) => (
                <div class="card">
                    <h3 class="text-lg mb-1">{person.name}</h3>
                    <p class="text-sm font-medium text-accent mb-1">{person.role}</p>
                    <p class="text-sm text-text-muted mb-2">{person.institution}</p>
                    <p class="text-sm text-text leading-relaxed">{person.topic}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- Collaborators -->
    <section class="mb-12">
        <h2 class="section-heading">Collaborators</h2>
        <div class="space-y-3">
            {collaborators.map((person) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 py-3 border-b border-border last:border-b-0">
                    <div class="sm:w-1/3">
                        <p class="font-semibold text-text">{person.name}</p>
                        <p class="text-sm text-text-muted">{person.institution}</p>
                    </div>
                    <p class="text-sm text-text-muted sm:w-2/3">{person.area}</p>
                </div>
            ))}
        </div>
    </section>
</Layout>
