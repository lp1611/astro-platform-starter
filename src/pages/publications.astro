---

<Layout title="Publications" description="Publications by Lekha Patel, organized by research theme.">
    <h1 class="mb-4">Publications</h1>
    <p class="text-text-muted mb-10">
        Publications organized by research theme. For a complete list, please visit my
        <a href="https://scholar.google.com/citations?user=ZKS9dtkAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a> profile.
    </p>

    {sections.map((section) => (
        <section class="mb-12">
            <h2 class="text-xl font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
                {section.title}
            </h2>

            {'entries' in section && section.entries && (
                <div>
                    {section.entries.map((pub) => (
                        <div class="pub-entry">
                            <div class="flex items-start justify-between gap-3">
                                <p class="pub-title">
                                    {'url' in pub && pub.url ? (
                                        <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                                    ) : (
                                        pub.title
                                    )}
                                </p>
                                <div class="flex items-center gap-2 shrink-0 mt-0.5">
                                    <span class="text-xs font-medium text-text-muted">{pub.year}</span>
                                    <span class={`inline-block text-xs font-medium px-2 py-0.5 rounded-full border ${typeColors[pub.type] || 'bg-gray-100 text-gray-700 border-gray-200'}`}>
                                        {pub.type}
                                    </span>
                                </div>
                            </div>
                            <p class="pub-authors">{pub.authors}</p>
                            <p class="pub-venue">{pub.venue}</p>
                        </div>
                    ))}
                </div>
            )}

            {'subsections' in section && section.subsections && section.subsections.map((sub) => (
                <div class="mb-8">
                    <h3 class="text-base font-semibold text-accent mb-3 mt-4 italic">{sub.subtitle}</h3>
                    <div>
                        {sub.entries.map((pub) => (
                            <div class="pub-entry">
                                <div class="flex items-start justify-between gap-3">
                                    <p class="pub-title">
                                        {'url' in pub && pub.url ? (
                                            <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                                        ) : (
                                            pub.title
                                        )}
                                    </p>
                                    <div class="flex items-center gap-2 shrink-0 mt-0.5">
                                        <span class="text-xs font-medium text-text-muted">{pub.year}</span>
                                        <span class={`inline-block text-xs font-medium px-2 py-0.5 rounded-full border ${typeColors[pub.type] || 'bg-gray-100 text-gray-700 border-gray-200'}`}>
                                            {pub.type}
                                        </span>
                                    </div>
                                </div>
                                <p class="pub-authors">{pub.authors}</p>
                                <p class="pub-venue">{pub.venue}</p>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </section>
    ))}
</Layout>
