---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Publications', href: '/publications' },
    { linkText: 'People', href: '/people' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-primary text-white">
    <div class="w-full max-w-4xl mx-auto px-6 sm:px-8">
        <nav class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-5 gap-3">
            <a href="/" class="nav-link text-xl font-bold tracking-tight no-underline text-white hover:text-accent-light transition-colors">
                Lekha Patel
            </a>
            <ul class="flex gap-1">
                {navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                                'nav-link inline-block px-4 py-2 rounded text-sm font-medium no-underline transition-colors',
                                currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                                    ? 'bg-white/20 text-white'
                                    : 'text-white/80 hover:text-white hover:bg-white/10',
                            ]}
                        >
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>
